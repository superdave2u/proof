# Ralph loop configuration template — copy to .env and edit.
# Precedence: real environment variables override anything set in .env.

# Model (provider/model):
#   openrouter/~openai/gpt-luna-latest   (openai luna, rolling alias — current default)
#   openrouter/openai/gpt-6-luna         (pinned openai luna)
#   openrouter/openai/gpt-6-luna-pro
#   openrouter/openai/gpt-5.6-luna-pro
# Run `opencode models` to list everything available.
RALPH_MODEL=openrouter/~openai/gpt-luna-latest

# Visibility: 1 = stream thinking blocks / harness logs to the console
RALPH_THINKING=1
RALPH_PRINT_LOGS=1
RALPH_LOG_LEVEL=INFO            # DEBUG | INFO | WARN | ERROR
RALPH_IDLE_SECONDS=30           # heartbeat after N seconds of silence

# Loop knobs
MAX_ITERATIONS=25               # ralph.sh only (ralph-plan.sh defaults to 3)
RALPH_SLEEP=5                   # seconds between iterations
PROMPT_FILE=                    # defaults to PROMPT.md / PROMPT-PLAN.md

# Optional offline watercolor card-art generation (npm run art:generate)
# OPENROUTER_API_KEY=           # falls back to local opencode auth store
# IMAGE_PROVIDER=openrouter     # art:loop pins this provider
# IMAGE_MODEL=google/gemini-3.1-flash-lite-image
# IMAGE_API_URL=                 # defaults to OpenRouter /api/v1/images
# The 4:3 aspect is requested in the prompt text; no ratio parameter is sent.
# Generated images are normalized to 800x600 by sharp before being saved.
# Do not commit API keys; use your local .env or environment.

# DANGEROUS: auto-approve all permissions (1 = on). Off by default.
RALPH_AUTO=0